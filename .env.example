# ============================================================
# .env.example — Copy this file to .env and fill in your keys
# NEVER commit the actual .env file to GitHub!
# ============================================================

# Get your free Gemini API key from: https://aistudio.google.com
GEMINI_API_KEY=your_gemini_api_key_here

# Any random string — used to encrypt Flask sessions
SECRET_KEY=nagarraksha-super-secret-2026-change-this

# Set to 'true' during development to skip real AI API calls
# Set to 'false' when you want to use real Gemini API
USE_MOCK_AI=false
